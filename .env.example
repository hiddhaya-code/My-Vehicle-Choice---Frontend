# ==============================================================================
# MyVehicleChoice — Frontend Environment Variables (.env)
# ==============================================================================

# Backend API Base URL
# In local development with Vite dev server reverse proxy, leave empty or set to /api/v1.
# In standalone deployment / Docker / production, set to your backend API endpoint:
# e.g., http://localhost:8080/api/v1 or https://api.myvehiclechoice.in/api/v1
VITE_API_BASE_URL=

# Vite Dev Server Port (optional, defaults to 5173)
VITE_PORT=5173
